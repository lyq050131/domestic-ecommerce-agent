# ===== DeepSeek（必填） =====
# 在 https://platform.deepseek.com 申请 API Key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ===== 淘宝客三要素（必填，真实数据唯一数据源） =====
# 1. 淘宝开放平台创建应用获取 AppKey / AppSecret（应用类型选"其他-自用型应用"）
# 2. 阿里妈妈后台开通淘宝客推广，获取推广位 PID（形如 mm_123456_789_8888）
# 3. TAOBAO_ADZONE_ID 填 PID 最后一段数字，即 8888
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
TAOBAO_GATEWAY=https://eco.taobao.com/router/rest
TAOBAO_SIGN_METHOD=md5
TAOBAO_PAGE_SIZE=20

# ===== 订单结算数据（可选，付费接口，需商家 OAuth 授权） =====
TAOBAO_ORDER_ENABLED=false
TAOBAO_ACCESS_TOKEN=

# ===== 可选 RAG 向量库（安装 chromadb + sentence-transformers 后生效） =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
VECTOR_DB_PATH=./data/vector_db

# ===== 爬取与闭环 =====
CRAWLER_DELAY=1
CRAWLER_MAX_RETRIES=3
QUALITY_THRESHOLD=0.75
AUTO_FEEDBACK=true
MAX_DOCS_PER_COLLECTION=200

# ===== 客服模板 =====
REPLY_TEMPLATES_PATH=./data/templates/reply_templates.json
# ===== HuggingFace 镜像（可选，国内网络加速） =====
# HF_ENDPOINT=https://hf-mirror.com

# ===== 报告落库与每日定时任务 =====
# 选品/投放报告自动写入 data/reports.db，运营后台可查历史与趋势
REPORT_DB_PATH=./data/reports.db
# 每日定时自动运行选品+投放分析并落库（AUTO_REPORT_ENABLED=true 生效）
AUTO_REPORT_ENABLED=true
AUTO_REPORT_TIME=09:30
AUTO_REPORT_CATEGORY=无线蓝牙耳机
AUTO_REPORT_COUNT=20
AUTO_REPORT_AD_TOP_N=15
